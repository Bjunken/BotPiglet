# Discord — from https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Guild (server) ID to register slash commands to instantly during development.
# Leave empty to register globally instead (takes up to ~1 hour to propagate).
DISCORD_GUILD_ID=

# Channel where Google Classroom updates get posted
CLASSROOM_CHANNEL_ID=

# Comma-separated Google Classroom course IDs to watch.
# Leave empty to watch every active course you're enrolled in.
CLASSROOM_COURSE_IDS=

# How often (in minutes) to check Classroom for new posts
CLASSROOM_POLL_INTERVAL_MINUTES=10
